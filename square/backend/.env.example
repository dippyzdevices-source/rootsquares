# =====================================================================================================================================================
# square/backend/.env.example   -   the SQUARE SERVER (one shared server that serves every square; Flask, port 5002 locally)
# Written for W26-R52, restructured into blocks in W26-R54 (2026-11-03). Every name below is read by square/backend/app/config.py (and the few files named in the text).
# Full reference: docs/setup/13-environment-variables.md.
# =====================================================================================================================================================
#
# HOW THIS FILE IS BUILT: IN BLOCKS
#   A BLOCK is a group of lines that only work TOGETHER. Every block starts with a line  ## BLOCK n: name  and ends at the next one. You switch a feature on or off by
#   uncommenting or commenting THE WHOLE BLOCK (every line of it), never half of one.
#
# HOW TO USE
#   1. Make the file for your environment by copying this one (all three are git-ignored, none is ever committed):
#        .env.local        your machine. Read by wsgi.py, so by `flask --app wsgi run --port 5002` and by the scripts in scripts\, wherever you start them.
#        .env.staging      a notebook for the Render STAGING service of the square server, and the file you point to for a command run from this machine against staging.
#        .env.production   the same for production.
#      Render never sees these files (they are not in git). On Render you paste the lines into the service's Environment tab.
#   2. For each block read its  WHERE  line, then keep it (uncommented, every line filled in) or comment the whole block. Replace every <placeholder>.
#      A line that still contains < > is a mistake.
#   3. Write NAME=value with no spaces around the = and no comment after the value (a comment goes on its own line above). No quotes needed.
#   4. Run a script against another file (PowerShell, from square\backend):
#        $env:ENV_FILE = '.env.staging'
#        .venv\Scripts\python.exe scripts\square_db.py upgrade <slug>
#        Remove-Item Env:ENV_FILE
#      ENV_FILE is a variable of the process, never a line inside a file. A value already in the shell or in Render's dashboard always wins over the file
#      (close the window when you are done, so no value is left behind).
#   5. Restart the server after any change. It never reloads by itself.
#   6. Secrets (marked SECRET): never in git, never in chat, never in a screenshot. Keep them in the password manager.
#
# WHERE:  L = .env.local (your machine)   S = .env.staging (Render staging)   P = .env.production (Render production, a later pass)
#         req = required   opt = optional   no = must NOT be set there
#
# MAKER (your own PowerShell; copy the line it prints into the password manager, never into chat). A random secret, about 53 characters:
#   $b = New-Object byte[] 40; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ([Convert]::ToBase64String($b) -replace '[+/=]','')
#
# This server runs in MANY-SQUARES MODE (PLATFORM_DATABASE_URL set, BLOCK 2): the host name of each request picks the square, and its own database, sign-in project and storage
# come from the platform database. The single-tenant settings (BLOCK 11) stay empty.


# =====================================================================================================================================================
## BLOCK 1: BASICS   WHERE: L=req   S=req   P=req      Both lines go together.
# =====================================================================================================================================================
# APP_ENV: development | production. This server has its own production mode (it is NOT the platform's ENV). production: a real SECRET_KEY is required, and <slug>.localhost
# addresses stop working. Staging uses production on purpose: it is a real deploy. L: development.
APP_ENV=development
# SECRET_KEY (SECRET): the session secret. L: optional (a built-in development key is used). S, P: production REFUSES to start with the built-in key or with fewer than 32
# characters. Make it: the random maker.
SECRET_KEY=<random 32+ characters>


# =====================================================================================================================================================
## BLOCK 2: THE LINK TO THE PLATFORM (many-squares mode)   WHERE: L=req   S=req   P=req      All five lines go together.
# =====================================================================================================================================================
# PLATFORM_DATABASE_URL (SECRET): the PLATFORM database (not a square's): the server reads the `squares` table to find a square by host name. Set = many-squares mode.
#   L: the same platform database your local backend uses.   S: the customer_app address (guide 41 Step 6: the server only reads the squares table; a read-only role of its
#   own is an open item).   P: the production platform database.
PLATFORM_DATABASE_URL=postgresql+psycopg://rs_admin:rootsquares_local_dev@localhost:5432/rootsquares_platform
# FERNET_KEY (SECRET): THE SAME VALUE AS THE PLATFORM'S (customer API and admin API). It opens each square's encrypted database address and keys. A different value = every
# square "cannot be opened". L: optional (empty = the same development key as the platform). S, P: required.
FERNET_KEY=<the platform's FERNET_KEY, the same value>
# PLATFORM_INTERNAL_KEY (SECRET): lets the platform ask what a module holds and has pending (header X-Internal-Key). MUST EQUAL the platform's SQUARE_INTERNAL_KEY.
# Empty = that address answers 404. L: optional.
PLATFORM_INTERNAL_KEY=<equal to SQUARE_INTERNAL_KEY of the platform>
# SQUARE_DOMAIN_SUFFIX: a square's default address is <slug>.<this>. Default rootsquares.com.
SQUARE_DOMAIN_SUFFIX=rootsquares.com
# PLATFORM_SITE_URL: the platform's public address. A locked feature in a square's admin (repeating events, automatic reminders) shows a "See the packages" button to
# <this>/dashboard. Only an http(s) address is accepted. Empty = no button.   L: http://localhost:5273   S: https://rootsquares.com
PLATFORM_SITE_URL=http://localhost:5273


# =====================================================================================================================================================
## BLOCK 3: THE SIGN-IN FALLBACK   WHERE: L=req   S=req   P=req      Both lines go together.
# =====================================================================================================================================================
# The server REFUSES TO START without a valid pair (there is no default on purpose), even in many-squares mode where each served square uses its OWN sign-in project.
# supabase | neon, and the provider's base URL (Supabase: https://<project-ref>.supabase.co). Use the platform's own pair (the same two values as in backend/.env.*).
AUTH_PROVIDER=supabase
AUTH_URL=https://<project-ref>.supabase.co


# =====================================================================================================================================================
## BLOCK 4: THE SITE GATE AND THE PROXY (a private staging)   WHERE: L=no   S=req   P=no (a public site has no gate)      The lines go together.
# =====================================================================================================================================================
# SITE_GATE_PASSWORD (SECRET): the staging passcode (ADR 099, guide 42). 16 or more characters. THE SAME VALUE as on the customer API and the admin API, so one passcode opens
# all of staging. Make it: the random maker. SITE_GATE_HOURS: how long a pass lasts (default 168).
# PROXY_HOPS: how many proxies stand in front of the service. Render: 1. The gate reads the caller's address from X-Forwarded-For with it. P: also 1 (it is about Render).
SITE_GATE_PASSWORD=<the same passcode as on the customer API and the admin API>
# SITE_GATE_HOURS=168
PROXY_HOPS=1


# =====================================================================================================================================================
## BLOCK 5: SUPPORT ACCESS   WHERE: L=opt   S=req   P=req      One line (empty = support access is off).
# =====================================================================================================================================================
# SUPPORT_SESSION_KEY (SECRET): support access (ADR 089, guide 38): the admin API signs a support session with it and THIS server verifies it with the SAME value.
# Equal to SUPPORT_SESSION_KEY of the admin API (32+ characters).
SUPPORT_SESSION_KEY=<equal to SUPPORT_SESSION_KEY of the admin API>


# =====================================================================================================================================================
## BLOCK 6: ANALYTICS   WHERE: L=opt   S=req   P=req      One line (empty = counting is off).
# =====================================================================================================================================================
# ANALYTICS_SALT_SECRET (SECRET): makes the daily visitor hash of the visit counter (ADR 090, guide 39). A long random value: the random maker.
ANALYTICS_SALT_SECRET=<random 32+ characters>


# =====================================================================================================================================================
## BLOCK 7: KEEP THE SERVER AWAKE   WHERE: L=no   S=opt   P=opt      One line (empty = the job does not start).
# =====================================================================================================================================================
# KEEP_ALIVE_URL: this server's own https://<its onrender address>/api/health. A background job calls it regularly so the host does not put the server to sleep.
# On a FREE Render instance this keeps the server awake all month, which uses about 744 of the 750 free hours shared by every free service: only this ONE service may do it
# (guide 41, free instances).
# KEEP_ALIVE_URL=https://<its onrender address>/api/health


# =====================================================================================================================================================
## BLOCK 8: E-MAIL   WHERE: L=opt   S=opt   P=opt      The lines go together (guide 25). Comment the block for "no e-mail".
# =====================================================================================================================================================
# This server ignores EMAIL_PROVIDER and EMAIL_REPLY_TO. Empty = no e-mail is sent; the first real send then fails with a clear message.
# RESEND_API_KEY (SECRET): a Resend key limited to sending (the same as the platform's). EMAIL_FROM: an address on a domain verified at Resend.
# CONTACT_EMAIL: FALLBACK only: the contact form and "payments to verify" notices go to the square's own e-mail contact; this value is used only when a square has none.
# RESEND_API_KEY=<resend sending key>
# EMAIL_FROM=rootsquares <hello@your-verified-domain>
# CONTACT_EMAIL=hello@rootsquares.com


# =====================================================================================================================================================
## BLOCK 9: SERVER-WIDE FILE STORAGE (a fallback)   WHERE: L=opt   S=opt   P=opt      All seven lines go together.
# =====================================================================================================================================================
# A square made by the platform brings its OWN storage (stored in the platform database). These are the server-wide default; with STORAGE_S3_ENDPOINT_URL empty the server
# uses an in-memory fake that saves nothing. Names as on the platform: guide 05 (Supabase) or guide 31 (Neon). STORAGE_PUBLIC_BASE_URL must end with the public bucket name.
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_REGION=auto
# STORAGE_PUBLIC_BUCKET=public
# STORAGE_PRIVATE_BUCKET=private
# STORAGE_PUBLIC_BASE_URL=


# =====================================================================================================================================================
## BLOCK 10: THE LOCAL DEVELOPMENT SITE   WHERE: L=opt   S=no (leave empty)   P=no (leave empty)
# =====================================================================================================================================================
# FRONTEND_ORIGIN: browser addresses allowed to call this server, comma separated. Empty in development = http://localhost:5274 and http://127.0.0.1:5274 (the Vite site). On
# Render leave it empty: the site is served from the same origin, so no cross-origin call exists.
# FRONTEND_ORIGIN=http://localhost:5274


# =====================================================================================================================================================
## BLOCK 11: SINGLE-TENANT MODE (a bca-oslo-style server)   WHERE: L=opt   S=no   P=no      The lines go together; the whole block stays commented in many-squares mode.
# =====================================================================================================================================================
# DATABASE_URL: the one database of a single-tenant server, and the target of `flask db` commands. NOT the platform database.
# SITE_NAME / SITE_DOMAIN / SITE_ORDER_PREFIX / SITE_CURRENCY / SITE_PHONE_COUNTRY: that server's identity (defaults BCA Oslo, localhost, BCA, NOK, NO). A served square uses its own.
# DATABASE_URL=postgresql+psycopg://rs_admin:rootsquares_local_dev@localhost:5432/square_dev
# SITE_NAME=BCA Oslo
# SITE_DOMAIN=localhost
# SITE_ORDER_PREFIX=BCA
# SITE_CURRENCY=NOK
# SITE_PHONE_COUNTRY=NO
# TEST_DATABASE_URL: tests only: the database the square tests use (default: an in-memory SQLite database).
# TEST_DATABASE_URL=


# =====================================================================================================================================================
## BLOCK 12: OTHER (all optional)   WHERE: L=opt   S=opt   P=opt
# =====================================================================================================================================================
# API_PUBLIC_URL: the public address of this server (for example https://api.example.com); only used for the one-click unsubscribe link of newsletter mails. Empty = the normal link.
# DATA_RETENTION_YEARS: orders older than this many full years lose buyer name, e-mail and phone (anonymised; rows and amounts stay). ADR 018; unverified until an accountant confirms.
# ERASE_DELETE_PROVIDER_ACCOUNT: true (default) = when a person is anonymised, their account at the square's own Supabase sign-in project is removed too; false keeps it.
# APP_VERSION: a version text shown in the health report (the platform's owner health view). Empty = none.
# API_PUBLIC_URL=
# DATA_RETENTION_YEARS=5
# ERASE_DELETE_PROVIDER_ACCOUNT=true
# APP_VERSION=
