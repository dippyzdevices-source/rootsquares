{
  "name": "rootsquares-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The workspace root of the rootsquares frontends (ADR 084): platform (customer app), admin (staff application), ui (shared design system). No dependencies live here; each package lists its own. The node tests of tests/ read across the packages.",
  "engines": { "node": ">=22" },
  "workspaces": ["platform", "admin", "ui"],
  "scripts": {
    "dev": "npm run dev -w @rootsquares/platform",
    "build": "npm run build -w @rootsquares/platform",
    "dev:admin": "npm run dev -w @rootsquares/admin",
    "build:admin": "npm run build -w @rootsquares/admin",
    "preview": "npm run preview -w @rootsquares/platform",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:separation": "node --test tests/separation.test.mjs",
    "test:gate": "node --test tests/gate.test.mjs",
    "test:identity": "node --test tests/identity.test.mjs",
    "test:hardening": "node --test tests/hardening.test.mjs",
    "test:built": "node --test tests/built.test.mjs",
    "audit:admin": "npm audit --omit=dev --audit-level=high -w @rootsquares/admin",
    "audit:platform": "npm audit --omit=dev --audit-level=critical -w @rootsquares/platform",
    "test:qr": "node --test tests/qr.test.mjs",
    "test:contrast": "node --test tests/contrast.test.mjs",
    "test:themes": "node --test tests/themes.test.mjs",
    "test:roles": "node --test tests/roles.test.mjs",
    "test:eventpass": "node --test tests/eventpass.test.mjs",
    "test:billing": "node --test tests/billing.test.mjs",
    "test:starter": "node --test tests/starter.test.mjs",
    "test:messages": "node --test tests/messages.test.mjs",
    "test:vouchers": "node --test tests/vouchers.test.mjs",
    "test:region": "node --test tests/region.test.mjs",
    "test:look": "node --test tests/look.test.mjs",
    "test:package": "node --test tests/package.test.mjs",
    "test:vouchersim": "node --test tests/vouchersim.test.mjs"
  }
}
