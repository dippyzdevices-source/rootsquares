# =====================================================================================================================================================
# frontend/platform/.env.example   -   the CUSTOMER APP (the platform's website: rootsquares.com; Vite, port 5273 locally)
# Written for W26-R52 (2026-11-03). Every name below is read in frontend/platform/src (env.d.ts lists them). Full reference: docs/setup/13-environment-variables.md.
# =====================================================================================================================================================
#
# EVERY VITE_ VALUE IS PUBLIC. It is written into the page when the site is built and anyone can read it in the browser. Never put a secret here. (The Supabase
# publishable key is public by design.) A changed value reaches the site only after a NEW BUILD: restart `npm run dev`, or redeploy the static site on Render.
#
# HOW TO USE THIS FILE
#   1. Make the file for your environment by copying this one (all three are git-ignored, none is ever committed):
#        .env.local        your machine. Vite reads it for `npm run dev` and for any build on this machine.
#        .env.staging      a notebook for the Render STAGING static site, and the file `--mode staging` uses on this machine.
#        .env.production   the same for production (`npm run build` uses it by default).
#      Render never sees these files (they are not in git). On Render you paste the lines into the static site's Environment tab (guide 41 Step 5).
#   2. Delete the lines your environment does not need (each variable says WHERE it belongs), then replace every <placeholder>.
#   3. Write NAME=value with no spaces around the = and no comment after the value. No quotes needed.
#   4. Run or build on this machine with another file (PowerShell, from frontend\; the npm workspace root):
#        npm run dev -w @rootsquares/platform -- --mode staging
#        npm run build -w @rootsquares/platform -- --mode staging
#      Vite then reads .env, .env.local, .env.staging (in that order, the later wins). .env.staging OVERRIDES .env.local, but a name that .env.staging lacks falls
#      through to .env.local. So put EVERY name you need in .env.staging and .env.production, do not rely on .env.local.
#      A value already in the shell or in Render's dashboard always wins over every file.
#
# WHERE:  L = .env.local (your machine)   S = .env.staging (Render staging)   P = .env.production (Render production, a later pass)
#         req = required   opt = optional   no = must NOT be set there


# =====================================================================================================================================================
# 1. A LINE IN EVERY ENVIRONMENT FILE
# =====================================================================================================================================================

# VITE_API_BASE_URL   WHERE: L=req   S=req   P=req
# The address (origin, no path) of the CUSTOMER API. The site calls <this>/api/platform/v1. A final / is ignored. Default http://localhost:5001.
#   L: http://localhost:5001      S: https://api.rootsquares.com (guide 41 Step 3)      P: the production customer API
VITE_API_BASE_URL=http://localhost:5001

# VITE_AUTH_PROVIDER / VITE_AUTH_URL / VITE_AUTH_PUBLIC_KEY   WHERE: L=req   S=req   P=req (neon: no key)
# The customer sign-in (ADR 028). They MUST MATCH the customer API's AUTH_PROVIDER and AUTH_URL (backend/.env.*).
#   L, S:  supabase | https://<project-ref>.supabase.co | the publishable key (starts sb_publishable_; Project Settings > API Keys). S: the NEW staging project, never the local test project.
#   P:     neon | the Neon Auth URL | no key. (The platform's own login on Neon Auth has never been run.)
# Empty provider = the platform's own cookie login only. If the provider is set but the URL (or, for Supabase, the key) is missing, the app refuses to start with a clear message.
VITE_AUTH_PROVIDER=supabase
VITE_AUTH_URL=https://<project-ref>.supabase.co
VITE_AUTH_PUBLIC_KEY=<sb_publishable_...>


# =====================================================================================================================================================
# 2. STAGING AND PRODUCTION ONLY
# =====================================================================================================================================================

# VITE_PLATFORM_HOSTS   WHERE: L=opt (empty = localhost,127.0.0.1)   S=req   P=req
# The host names that show the platform itself, comma separated. ANY OTHER HOST NAME IS TREATED AS A SQUARE (<slug>.localhost, <slug>.rootsquares.com or a customer's own domain),
# so if the real address is missing here, https://rootsquares.com would be shown as a square.
#   S: rootsquares.com,www.rootsquares.com
VITE_PLATFORM_HOSTS=rootsquares.com,www.rootsquares.com


# =====================================================================================================================================================
# 3. OPTIONAL (every line below is commented out: the value shown is the default, or the usual choice)
# =====================================================================================================================================================

# VITE_DEMO_SITE_URL   The neutral demo site shown in the theme previews (the square site opened with ?demo=1). Empty while developing = http://demo.localhost:5274/ (the square site's dev server).
# Staging/production: the address of the demo square site, for example https://demo.rootsquares.com/ . If it is empty in a build, the preview shows the card "The preview isn't available right now".
# VITE_DEMO_SITE_URL=

# VITE_SQUARE_APP_PORT   Development only: the port of the square site next to this one. Default 5274 (a build ignores it). Empty = the old hello-world page.
# VITE_SQUARE_APP_PORT=5274

# VITE_USE_MOCK   false (default) = the real API. true = an in-browser mock of the platform API: no backend is needed and the provider sign-in is OFF. Never true in staging or production.
# VITE_USE_MOCK=false
