# Supply-chain hygiene for the whole workspace (ADR 084, section 3.2).
# No install-time scripts run from any package; a package that truly needs one is named and checked by hand.
ignore-scripts=true
# New dependencies are written with an exact version, not a range.
save-exact=true
# engine-strict is NOT set yet: a dependency (ast-walker-scope) asks for Node 22.18+ or 24.11+ and this machine has 24.2, so a strict install fails.
# Upgrade Node (OPEN_ITEMS), then add `engine-strict=true`.
